-- WAIT

local function waitActive(seconds)

    local elapsed = 0

    while elapsed < seconds do

        if not running then return false end

        task.wait(0.05)

        elapsed += 0.05

    end

    return running

end



-- ACTIVATE PICKAXE: one immediate attempt, then at most one cooldown retry.

-- The supplied Basic Pickaxe LocalScript has a 1.5s local lock; calls during

-- that lock are ignored. This queues the next valid activation without spam.

local function activatePickaxe()

    if not running then return false end



    local now = os.clock()

    local elapsed = now - lastPickaxeActivateAt

    if elapsed < PICKAXE_COOLDOWN then

        -- Tidak melakukan spam yang melewati cooldown.
        -- Tunggu hanya sisa cooldown, lalu kirim satu aktivasi yang sah.
        local remaining = PICKAXE_COOLDOWN - elapsed

        if remaining > 0 and not waitActive(remaining) then return false end

    end



    if not running then return false end

    local tool = getPickaxe()

    if not tool then return false end



    tool:Activate()

    lastPickaxeActivateAt = os.clock()

    if noAnimation then stopMiningAnimations() end

    return true

end



-- MINE ONE CRYSTAL: equip before teleport so the first valid hit can fire

-- immediately on arrival (subject only to the pickaxe's built-in cooldown).

local function mineOneCrystal(target)
    if not running or not characterReady or not target or not target.Parent then return false end
    if isExcludedCrystal(target) then
        status.Text = "Crystal di lokasi pengecualian - skip"
        return false
    end

    local initialHP = getHP(target)
    if not initialHP or initialHP <= 0 then return false end

    local character, root, humanoid = getCharacter()
    local tool = getPickaxe()
    if not tool then
        status.Text = "Basic Pickaxe tidak ditemukan"
        return false
    end

    if tool.Parent ~= character then
        humanoid:EquipTool(tool)
        if not waitActive(EQUIP_SETTLE) then return false end
        character = player.Character or character
        character, root, humanoid = getCharacter()
    end

    local destination = getSafePosition(target, character, root)
    if not destination then
        status.Text = "Lokasi tidak aman - skip"
        return false
    end

    -- Berjalan menuju titik aman di samping Crystal; tidak mengubah CFrame/teleport.
    status.Text = "Berjalan menuju Crystal..."
    humanoid:MoveTo(destination)

    local walkElapsed = 0
    local walkTimeout = 30
    local nextMoveRefresh = 6
    while running and characterReady and walkElapsed < walkTimeout do
        if not target.Parent then
            status.Text = "Crystal sudah hilang saat menuju lokasi"
            return false
        end

        character = player.Character
        root = character and character:FindFirstChild("HumanoidRootPart")
        humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or humanoid.Health <= 0 then
            status.Text = "Karakter belum siap untuk berjalan"
            return false
        end

        if (root.Position - destination).Magnitude <= 3.5 then
            break
        end

        -- MoveTo memiliki timeout internal; perbarui tujuan selama perjalanan.
        if walkElapsed >= nextMoveRefresh then
            humanoid:MoveTo(destination)
            nextMoveRefresh += 6
        end

        task.wait(0.2)
        walkElapsed += 0.2
    end

    if not running then return false end

    if not root or (root.Position - destination).Magnitude > 3.5 then
        humanoid:MoveTo(root and root.Position or destination)
        status.Text = "Gagal mencapai Crystal dengan berjalan - skip"
        return false
    end

    -- Hadapkan karakter ke Crystal setelah tiba, tanpa memindahkan posisinya.
    local lookAt = Vector3.new(target.Position.X, root.Position.Y, target.Position.Z)
    root.CFrame = CFrame.lookAt(root.Position, lookAt)
    status.Text = "Tiba di Crystal - menunggu 1,5 detik..."
    if not waitActive(1.5) then return false end

    -- Jangan pindah hanya karena label HP terlambat diperbarui.
    -- Kirim 3 aktivasi berurutan dengan jeda sesuai cooldown pickaxe.
    for hit = 1, 3 do
        if not running or not characterReady then return false end
        if not target.Parent then
            status.Text = "Crystal sudah hilang"
            return true
        end

        local currentHP = getHP(target)
        if currentHP and currentHP <= 0 then
            status.Text = "Crystal selesai"
            return true
        end

        status.Text = "Mining crystal - hit " .. hit .. "/3"
        if not activatePickaxe() then
            status.Text = "Pickaxe belum siap - mining dihentikan"
            return false
        end

        if hit < 3 then
            if not waitActive(HIT_DELAY) then return false end
            -- HP boleh terlambat berubah; jangan membatalkan rangkaian hit.
            if not target.Parent then
                status.Text = "Crystal selesai"
                return true
            end
            local observedHP = getHP(target)
            if observedHP and observedHP <= 0 then
                status.Text = "Crystal selesai"
                return true
            end
        else
            if not waitActive(NEXT_CRYSTAL_DELAY) then return false end
            local finalHP = target.Parent and getHP(target) or 0
            if not target.Parent or (finalHP and finalHP <= 0) then
                status.Text = "Crystal terkonfirmasi selesai"
            else
                status.Text = "3 hit terkirim - hasil menunggu update server"
            end
            return true
        end
    end

    return false
end



-- MAIN MINING LOOP

local function miningLoop()

    while running do

        if not characterReady then
            status.Text = "Menunggu karakter respawn..."
            if not waitActive(0.5) then break end
        else
        local targets = refreshTargets()

        if #targets == 0 then

            status.Text = "Menunggu Crystal HP 3"

            if not waitActive(1.5) then break end

        else

            local found = false

            for _, targetInfo in ipairs(targets) do

                if not running then break end

                local target = targetInfo.part

                if target and target.Parent and getHP(target) == HP_REQUIRED then

                    found = true

                    local completed = mineOneCrystal(target)
                    if completed then
                        -- Catat setelah rangkaian mining selesai, bukan sebelum mulai.
                        lastMinedAtByPosition[targetInfo.positionKey] = os.clock()
                        completedCrystalCount = completedCrystalCount + 1
                        status.Text = "Siklus selesai: " .. completedCrystalCount
                    end
                    break

                end

            end

            if not found and not waitActive(0.5) then break end

        end
        end

    end

    if not destroyed then

        status.Text = "MINING OFF"

        onButton.Text = "ON MINING"

        setFloatStatus(false)

    end

end



